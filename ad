connect(field.FocusLost, function()
local value = tonumber(field.Text)
if not finite(value) then notify("Enter a finite number for " .. title, true) refresh() return end
commit(function() state[key] = constrain(key, value) end)
end)
if sliderMin then
local track = make("TextButton", {
Text = "", Position = UDim2.fromOffset(0, 37), Size = UDim2.new(1, 0, 0, 12),
BackgroundColor3 = palette.field, BorderSizePixel = 0, AutoButtonColor = false,
}, object)
local fill = make("Frame", {Size = UDim2.new(), BackgroundColor3 = palette.accent, BorderSizePixel = 0}, track)
controls[key].fill = fill
controls[key].min, controls[key].max = sliderMin, sliderMax
local function slide(point)
local fraction = math.clamp((point.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
state[key] = constrain(key, sliderMin + fraction * (sliderMax - sliderMin))
refresh()
end
connect(track.InputBegan, function(input)
if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
sliderDrag = {before = clone(state), update = slide, input = input}
slide(Vector2.new(input.Position.X, input.Position.Y))
end)
end
return minus
end
