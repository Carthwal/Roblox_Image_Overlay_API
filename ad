local function importSettings()
if loading then notify("Wait for the image load to finish", true) return end
local ok, payload = pcall(HttpService.JSONDecode, HttpService, settingsBox.Text)
if not ok or type(payload) ~= "table" or payload.version ~= 1 or type(payload.transform) ~= "table" then
notify("Invalid settings JSON (expected version 1)", true) return
end
local nextState = clone(state)
for key, value in pairs(nextState) do
local supplied = payload.transform[key]
if supplied ~= nil then
if type(value) == "boolean" then
if type(supplied) ~= "boolean" then notify("Invalid setting: " .. key, true) return end
nextState[key] = supplied
else
if not finite(supplied) then notify("Invalid number: " .. key, true) return end
nextState[key] = constrain(key, supplied)
end
end
end
if type(payload.url) == "string" and payload.url ~= sourceURL then
loadImage(payload.url, nextState)
else
commit(function() state = nextState end)
notify("Settings imported")
end
end
