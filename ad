-- Prefer an existing service instance, then fall back to GetService.
-- Call service methods explicitly.
local function service(name)
local ok, direct = pcall(function() return game[name] end)
if ok and typeof(direct) == "Instance" and direct.ClassName == name then
return direct
end
local fetched, result = pcall(function() return game:GetService(name) end)
if fetched and typeof(result) == "Instance" then return result end
error("Cannot access Roblox service " .. name .. ": " .. tostring(result) ..
". Run inside a loaded Roblox client and check the executor environment.", 2)
end
