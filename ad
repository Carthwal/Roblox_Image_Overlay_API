local function effectiveRenderDensity(width, height, sourceSize, requested)
local sourceDensity = sourceSize and math.max(sourceSize.X / width, sourceSize.Y / height) or 0
-- Keep at least the source detail where possible and bound the render canvas.
return math.min(math.max(requested, sourceDensity), CONFIG.MaxCanvasDimension / math.max(width, height))
end
refresh = function()
if not alive then return end
local width = math.clamp(state.width * state.scale, 0.1, 2048)
local height = math.clamp(width / state.aspect, 0.1, 2048)
plane.Size = Vector3.new(width, height, CONFIG.Thickness)
-- Local -Z faces upward; local X/Y are the image's right/up axes.
local angle = math.rad(state.yaw)
local right = Vector3.new(math.cos(angle), 0, -math.sin(angle))
local up = Vector3.new(math.sin(angle), 0, math.cos(angle))
local center = Vector3.new(state.x, state.y + state.offset - CONFIG.Thickness / 2, state.z)
plane.CFrame = CFrame.fromMatrix(center, right, up, Vector3.new(0, -1, 0))
surface.Enabled = editable ~= nil and state.visible and not heldC
surface.AlwaysOnTop = state.onTop
surface.PixelsPerStud = effectiveRenderDensity(width, height, imageSize, state.density)
local resampling = state.sharpPixels and Enum.ResamplerMode.Pixelated or Enum.ResamplerMode.Default
image.ResampleMode = resampling
preview.ResampleMode = resampling
image.ImageTransparency = state.transparency
for key, control in pairs(controls) do
if not control.field:IsFocused() then control.field.Text = string.format("%.4f", state[key]):gsub("0+$", ""):gsub("%.$", "") end
if control.fill then
local fraction = math.clamp((state[key] - control.min) / (control.max - control.min), 0, 1)
control.fill.Size = UDim2.fromScale(fraction, 1)
end
end
for key, box in pairs(toggles) do
box.Text = state[key] and "X" or ""
box.BackgroundColor3 = state[key] and palette.accent or palette.field
end
collapseButton.Text = collapsed and "+" or "-"
drawButton.Text = drawing and "Drawing..." or "Start auto draw"
dimensions.Text = string.format("%.2f x %.2f studs | %s", width, height,
imageSize and string.format("%d x %d px", imageSize.X, imageSize.Y) or "No image")
fitPanel()
end
commit = function(change)
if placing then cancelPlace() end
local before = clone(state)
change()
record(before)
refresh()
end

local function fetchMatrixJSON(url)
local requestFunction = CONFIG.Request or env.request or env.http_request or request or http_request
local synTable = env.syn or syn
local httpTable = env.http or http
if type(requestFunction) ~= "function" and type(synTable) == "table" then requestFunction = synTable.request end
if type(requestFunction) ~= "function" and type(httpTable) == "table" then requestFunction = httpTable.request end
local body
if type(requestFunction) == "function" then
local response = requestFunction({Url = url, Method = "GET", Timeout = 30})
assert(type(response) == "table", "HTTP function returned an invalid response")
local code = tonumber(response.StatusCode or response.Status)
assert(code and code >= 200 and code < 300, "Image API HTTP " .. tostring(code or "unknown"))
body = response.Body
else
local ok, result = pcall(function() return game:HttpGet(url) end)
if ok then body = result
else
local httpOK, response = pcall(HttpService.RequestAsync, HttpService, {Url = url, Method = "GET"})
assert(httpOK and type(response) == "table" and response.Success,
"HTTP unavailable. Your executor needs request/http_request or game:HttpGet support.")
body = response.Body
end
end
assert(type(body) == "string" and #body > 0, "Image API returned an empty body")
assert(#body <= CONFIG.MaxResponseBytes, "Image API response too large; use a smaller source image")
local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
assert(ok and type(data) == "table", "Image API returned invalid JSON")
assert(not data.error, "Image API: " .. tostring(data.error))
return data
end
local function matrixToBuffer(data, maxPixels)
assert(type(data) == "table", "Image API returned invalid matrix data")
local w, h = data.width, data.height
assert(finite(w) and finite(h) and w >= 1 and h >= 1 and w % 1 == 0 and h % 1 == 0,
"Image API returned invalid dimensions")
assert(w * h <= 8000000 and type(data.pixels) == "table", "Image API matrix is invalid or too large")
assert(finite(maxPixels), "Invalid resize limit")
local limit = math.floor(math.clamp(maxPixels, 1, 500))
-- Published worker ignores resize; bound EditableImage dimensions locally.
local factor = math.min(1, limit / math.max(w, h))
local width, height = math.max(1, math.floor(w * factor)), math.max(1, math.floor(h * factor))
local output = buffer.create(width * height * 4)
for y = 0, height - 1 do
local sourceY = math.min(h, math.floor((y + 0.5) * h / height) + 1)
local row = data.pixels[sourceY]
assert(type(row) == "table", "Image API matrix has a missing row")
for x = 0, width - 1 do
local sourceX = math.min(w, math.floor((x + 0.5) * w / width) + 1)
local pixel = row[sourceX]
assert(type(pixel) == "table", "Image API matrix has a missing pixel")
local index = (y * width + x) * 4
for channel = 1, 4 do
local value = channel == 4 and (pixel[4] or 255) or pixel[channel]
assert(finite(value) and value >= 0 and value <= 255, "Image API returned an invalid color channel")
buffer.writeu8(output, index + channel - 1, math.round(value))
end
end
end
return output, Vector2.new(width, height)
end
local builtinParser = {}
function builtinParser:ParseImage(url, resize)
local endpoint = CONFIG.APIURL:gsub("/+$", "")
assert(endpoint:match("^https?://"), "Invalid image API endpoint")
return fetchMatrixJSON(endpoint .. "/?url=" .. HttpService:UrlEncode(url) .. "&resize=" .. tostring(resize))
end
function builtinParser:ToEditableImage(data, maxPixels)
local pixelBuffer, size = matrixToBuffer(data, maxPixels or CONFIG.Resolution)
local candidate = AssetService:CreateEditableImage({Size = size})
assert(candidate, "EditableImage memory budget exhausted; lower Max pixels")
local ok, err = pcall(candidate.WritePixelsBuffer, candidate, Vector2.zero, size, pixelBuffer)
if not ok then candidate:Destroy() error(tostring(err), 0) end
return candidate
end
function builtinParser:ParseImageToEditableImage(url, resize)
return self:ToEditableImage(self:ParseImage(url, resize), resize)
end
local function resolveParser()
local parser = CONFIG.Parser or env.ImageParser
if not parser and CONFIG.ParserModule then parser = require(CONFIG.ParserModule) end
if not parser and typeof(script) == "Instance" then
local module = script:FindFirstChild("ImageParser")
if module and module:IsA("ModuleScript") then parser = require(module) end
end
parser = parser or builtinParser
assert(type(parser) == "table" and type(parser.ParseImageToEditableImage) == "function", "Invalid ImageParser override")
return parser
end
loadImage = function(url, importedState)
if loading then notify("An image is already loading", true) return end
url = tostring(url):match("^%s*(.-)%s*$")
if not url:match("^https?://") then notify("Enter an http:// or https:// image URL", true) return end
loading = true
loadVersion = loadVersion + 1
local version = loadVersion
local resolution = CONFIG.Resolution
loadButton.Text = "..."
notify("Loading image...")
task.spawn(function()
local ok, result = pcall(function()
return resolveParser():ParseImageToEditableImage(url, resolution)
end)
if not alive or version ~= loadVersion then
if ok and isEditableImage(result) then result:Destroy() end
return
end
loading = false
loadButton.Text = "Load"
if not ok or not isEditableImage(result) then
local message = ok and "Parser returned no EditableImage" or tostring(result)
warn("GroundImageOverlay: " .. message)
notify(message, true)
return
end
local candidate = result
local readOK, newPixels = pcall(candidate.ReadPixelsBuffer, candidate, Vector2.zero, candidate.Size)
local renderOK, renderError = pcall(function()
local content = Content.fromObject(candidate)
image.ImageContent = content
preview.ImageContent = content
end)
if not renderOK then
if editable then
pcall(function()
image.ImageContent = Content.fromObject(editable)
preview.ImageContent = Content.fromObject(editable)
end)
else
image.Image = ""
preview.Image = ""
end
candidate:Destroy()
notify("ImageContent unavailable: " .. tostring(renderError), true)
return
end
local old = editable
editable, pixels, imageSize = candidate, readOK and newPixels or nil, candidate.Size
sourceURL, urlBox.Text = url, url
commit(function()
if importedState then state = importedState
else state.aspect = constrain("aspect", imageSize.X / imageSize.Y) end
end)
if old and old ~= editable then old:Destroy() end
notify(readOK and "Image loaded" or "Image loaded; pixel reads unavailable", not readOK)
end)
end

-- Build disjoint, filled rectangles from image cells. Exact same-color cells
-- become one shape when merging is enabled, with no gaps or overlapping edges.
local function drawTrackerToken()
local trackers = player:FindFirstChild("Trackers")
assert(trackers, "Player.Trackers is missing")
local chosen
for _, child in ipairs(trackers:GetChildren()) do
if child.Name:match("^Tracker%(") then chosen = child end
end
assert(chosen, "No Tracker(...) found in Player.Trackers")
return chosen.Name:match("^Tracker%((.*)%)$") or chosen.Name:sub(9)
end

local function roundedChannel(channel, levels)
return math.clamp(math.round(math.round(channel / 255 * (levels - 1)) * 255 / (levels - 1)), 0, 255)
end

local function buildDrawRectangles(drawState)
assert(pixels and imageSize, "Load an image with readable pixels first")
local worldWidth = math.clamp(drawState.width * drawState.scale, 0.1, 2048)
local worldHeight = math.clamp(worldWidth / drawState.aspect, 0.1, 2048)
local minCell = math.max(CONFIG.MinDrawPixelSize, drawState.drawPixelSize)
-- Use one scale factor for the source grid so sampling keeps its proportions.
-- Never generate more cells than source pixels or DrawMaxDimension per axis.
local factor = math.min(1, CONFIG.DrawMaxDimension / math.max(imageSize.X, imageSize.Y),
worldWidth / (minCell * imageSize.X), worldHeight / (minCell * imageSize.Y))
local columns = math.max(1, math.floor(imageSize.X * factor + 1e-7))
local rows = math.max(1, math.floor(imageSize.Y * factor + 1e-7))
local cellW, cellH = worldWidth / columns, worldHeight / rows
assert(cellW >= CONFIG.MinDrawPixelSize - 1e-7 and cellH >= CONFIG.MinDrawPixelSize - 1e-7,
"Image too small for 0.05-stud pixels")
local grid = {}
local levels = math.floor(drawState.colorSteps)
for y = 1, rows do
local sourceY = math.min(imageSize.Y - 1, math.floor((y - 0.5) * imageSize.Y / rows))
grid[y] = {}
for x = 1, columns do
-- Always mirror source columns to correct the game's horizontal draw orientation.
local sourceX = imageSize.X - 1 - math.min(imageSize.X - 1, math.floor((x - 0.5) * imageSize.X / columns))
local pos = (sourceY * imageSize.X + sourceX) * 4
local r, g, b, a = buffer.readu8(pixels, pos), buffer.readu8(pixels, pos + 1),
buffer.readu8(pixels, pos + 2), buffer.readu8(pixels, pos + 3)
if not drawState.skipTransparent or a >= 128 then
if drawState.roundColors then
r, g, b = roundedChannel(r, levels), roundedChannel(g, levels), roundedChannel(b, levels)
end
grid[y][x] = {key = r * 65536 + g * 256 + b, r = r, g = g, b = b}
end
end
if y % 64 == 0 then task.wait() end
end
local rects = {}
for y = 1, rows do
for x = 1, columns do
local color = grid[y][x]
if color then
local w, h = 1, 1
if drawState.mergeColors then
while x + w <= columns and grid[y][x + w] and grid[y][x + w].key == color.key do
w = w + 1
end
local extending = true
while y + h <= rows and extending do
for xx = x, x + w - 1 do
if not grid[y + h][xx] or grid[y + h][xx].key ~= color.key then
extending = false
break
end
end
if extending then h = h + 1 end
end
end
table.insert(rects, {x = x - 1, y = y - 1, w = w, h = h, color = color})
for yy = y, y + h - 1 do
for xx = x, x + w - 1 do grid[yy][xx] = nil end
end
end
end
if y % 64 == 0 then task.wait() end
end
return rects, worldWidth, worldHeight, cellW, cellH
end

stopDraw = function()
drawGeneration = drawGeneration + 1
drawing = false
if alive then refresh() notify("Auto draw stopped") end
end

startDraw = function()
if drawing then notify("Auto draw already running") return end
if not pixels then notify("Load an image with readable pixels first", true) return end
drawing = true
drawGeneration = drawGeneration + 1
local generation = drawGeneration
local drawState = clone(state)
refresh()
task.spawn(function()
local ok, err = pcall(function()
local tracker = drawTrackerToken()
local remote = ReplicatedStorage:WaitForChild("packages"):WaitForChild("_Index"):WaitForChild("vorlias_net@2.1.4"):WaitForChild("net"):WaitForChild("_NetManaged"):WaitForChild("createShape")
local rects, worldWidth, worldHeight, cellW, cellH = buildDrawRectangles(drawState)
if generation ~= drawGeneration or not alive then return end
notify(string.format("Drawing %d x %d cells as %d rectangles...", math.round(worldWidth / cellW), math.round(worldHeight / cellH), #rects))
local angle = math.rad(drawState.yaw)
local right = Vector2.new(math.cos(angle), -math.sin(angle))
local down = Vector2.new(-math.sin(angle), -math.cos(angle))
local center = Vector2.new(drawState.x, drawState.z)
local batchSize = math.clamp(math.floor(CONFIG.DrawBatchSize), 1, 16)
for i, rect in ipairs(rects) do
if generation ~= drawGeneration or not alive then return end
local w, h = rect.w * cellW, rect.h * cellH
local offsetX = (rect.x * cellW + w / 2) - worldWidth / 2
local offsetY = (rect.y * cellH + h / 2) - worldHeight / 2
local middle = center + right * offsetX + down * offsetY
-- Rectangle endpoints describe opposite corners before its rotation is applied.
-- Keep the entire centered stroke inside this cell's footprint.
-- A stroke at least half the short side closes the interior for a filled pixel.
local stroke = math.min(math.min(w, h), math.max(CONFIG.MinDrawPixelSize, math.min(w, h) / 2))
local halfX = math.max(0, (w - stroke) / 2)
local halfY = math.max(0, (h - stroke) / 2)
local p1 = middle - Vector2.new(halfX, halfY)
local p2 = middle + Vector2.new(halfX, halfY)
remote:FireServer(CONFIG.DrawID, {
tracker,
{color = Color3.fromRGB(rect.color.r, rect.color.g, rect.color.b),
transparency = 0, thickness = stroke},
{rotation = angle, startPoint = p1, endPoint = p2,
options = {polygonVertices = 5, geometryType = "Rectangle", polygonInnerRadius = 0.4}}
})
if i % 100 == 0 then notify(string.format("Auto draw %d / %d", i, #rects)) end
-- Yield between small batches so Stop and other UI actions remain responsive.
if i % batchSize == 0 then task.wait(CONFIG.DrawDelay) end
end
notify(string.format("Auto draw complete: %d rectangles", #rects))
end)
if not ok then notify("Auto draw error: " .. tostring(err), true) end
if generation == drawGeneration then drawing = false refresh() end
end)
end

local function imageUV(ray)
if not ray or not editable then return nil end
local origin = plane.CFrame:PointToObjectSpace(ray.Origin)
local direction = plane.CFrame:VectorToObjectSpace(ray.Direction)
if direction.Z <= 1e-7 then return nil end -- Only the upward-facing image side.
local distance = (-CONFIG.Thickness / 2 - origin.Z) / direction.Z
if distance < 0 or distance > CONFIG.RayDistance then return nil end
local point = origin + direction * distance
local u, v = point.X / plane.Size.X + 0.5, 0.5 - point.Y / plane.Size.Y
if u < 0 or u >= 1 or v < 0 or v >= 1 then return nil end
if not state.onTop then
local obstruction = raycast(ray.Origin, ray.Direction * math.max(0, distance - 0.005))
if obstruction then return nil end
end
return u, v
end
local function previewUV(point)
if not imageSize or collapsed or not over(preview, point) or not over(scroll, point) then return nil end
local pos, size = preview.AbsolutePosition, preview.AbsoluteSize
local scale = math.min(size.X / imageSize.X, size.Y / imageSize.Y)
local display = imageSize * scale
local start = pos + (size - display) / 2
local u, v = (point.X - start.X) / display.X, (point.Y - start.Y) / display.Y
if u < 0 or u >= 1 or v < 0 or v >= 1 then return nil end
return u, v
end
local function publishColor(r, g, b, description)
lastHex = string.format("#%02X%02X%02X", r, g, b)
hexBox.Text = lastHex
swatch.BackgroundColor3 = Color3.fromRGB(r, g, b)
sampleLabel.Text = description
copyText(lastHex, "Copied " .. lastHex)
end
local function sample()
local point = UIS:GetMouseLocation()
local ray = cursorRay()
local u, v
if panel.Visible and not collapsed then u, v = previewUV(point) end
if not u and overUI(point) then notify("Hover the image preview or the world image", true) return end
if not u then u, v = imageUV(ray) end
if u then
if not pixels then notify("This parser/runtime did not allow pixel reads", true) return end
local x = math.clamp(math.floor(u * imageSize.X), 0, imageSize.X - 1)
local y = math.clamp(math.floor(v * imageSize.Y), 0, imageSize.Y - 1)
local index = (y * imageSize.X + x) * 4
local r, g, b, a = buffer.readu8(pixels, index), buffer.readu8(pixels, index + 1),
buffer.readu8(pixels, index + 2), buffer.readu8(pixels, index + 3)
publishColor(r, g, b, string.format("Image pixel %d, %d | alpha %d/255", x, y, a))
return
end
if state.partFallback and ray then
local hit = raycast(ray.Origin, ray.Direction * CONFIG.RayDistance)
if hit and hit.Instance:IsA("BasePart") then
local color = hit.Instance.Color
publishColor(math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255), "Part base color: " .. hit.Instance.Name)
return
end
end
notify("No image pixel under cursor", true)
end

local function bind(name, keys, callback)
local fullName = "GroundImageOverlay_" .. name
table.insert(actionNames, fullName)
CAS:BindActionAtPriority(fullName, callback, false, Enum.ContextActionPriority.High.Value + 10, table.unpack(keys))
end
bind("Hotkeys", {Enum.KeyCode.C, Enum.KeyCode.E, Enum.KeyCode.P, Enum.KeyCode.RightShift, Enum.KeyCode.Escape}, function(actionName, inputState, input)
local key = input.KeyCode
if key == Enum.KeyCode.C and (inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel) then
heldC = false
refresh()
return Enum.ContextActionResult.Pass
end
if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
if inputState ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
if key == Enum.KeyCode.C then heldC = true refresh()
elseif key == Enum.KeyCode.E then sample()
elseif key == Enum.KeyCode.P then beginPlace()
elseif key == Enum.KeyCode.RightShift then panel.Visible = not panel.Visible
elseif key == Enum.KeyCode.Escape and placing then cancelPlace()
else return Enum.ContextActionResult.Pass end
return Enum.ContextActionResult.Sink
end)
bind("Placement", {Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2}, function(actionName, inputState, input)
if not placing or overUI(UIS:GetMouseLocation()) then return Enum.ContextActionResult.Pass end
if inputState == Enum.UserInputState.Begin then
if input.UserInputType == Enum.UserInputType.MouseButton2 then cancelPlace()
else
local ray = cursorRay()
local hit = ray and raycast(ray.Origin, ray.Direction * CONFIG.RayDistance)
if hit then
setPosition(hit.Position)
record(placeBefore)
placing, placeBefore = false, nil
refresh()
notify("Image placed")
else notify("Point at a surface before placing", true) end
end
end
return Enum.ContextActionResult.Sink
end)
