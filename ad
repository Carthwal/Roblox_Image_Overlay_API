local function connect(signal, callback)
local connection = signal:Connect(callback)
table.insert(connections, connection)
return connection
end
local function make(className, props, parent)
local object = Instance.new(className)
for key, value in pairs(props) do object[key] = value end
object.Parent = parent
return object
end
local function clone(value)
local result = {}
for key, item in pairs(value) do result[key] = item end
return result
end
local function same(a, b)
for key, value in pairs(a) do if b[key] ~= value then return false end end
return true
end
local function record(before)
if same(before, state) then return end
table.insert(history, before)
if #history > 60 then table.remove(history, 1) end
future = {}
end
local function finite(value)
return type(value) == "number" and value == value and math.abs(value) < math.huge
end
local function isEditableImage(value)
-- EditableImage inherits Object, so do not require typeof(value) == "Instance".
local ok, matches = pcall(function() return value:IsA("EditableImage") end)
return ok and matches
end
local limits = {
x = {-1000000, 1000000}, y = {-1000000, 1000000}, z = {-1000000, 1000000},
width = {0.1, 1000}, aspect = {0.05, 20}, scale = {0.01, 100},
yaw = {-36000, 36000}, offset = {-1000, 1000}, transparency = {0, 1}, snap = {0, 1000},
density = {8, 256},
drawPixelSize = {0.05, 100}, colorSteps = {2, 256},
}
local function constrain(key, value)
local range = limits[key]
return math.clamp(value, range[1], range[2])
end

