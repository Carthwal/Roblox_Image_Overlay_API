if placing then cancelPlace() return end
if #history == 0 then return end
table.insert(future, clone(state))
state = table.remove(history)
refresh()
end
local function redo()
if placing then cancelPlace() end
if #future == 0 then return end
table.insert(history, clone(state))
state = table.remove(future)
refresh()
end
